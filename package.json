{
  "name": "vichensolarapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "vite",
    "build": "vite build",
    "build:desktop": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.vichensolarapp.desktop",
    "productName": "Vichen Solar App",
    "icon": "public/icon.png",
    "directories": {
      "output": "dist-electron-bin"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "sharp": "^0.35.3",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4"
  }
}
