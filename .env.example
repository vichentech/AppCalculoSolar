# ── VichenSolarApp — Variables de entorno ──────────────────────────────────
# Copia este archivo como .env y ajusta los valores.

# URL base del servicio N8N
# - Desarrollo local: http://localhost:5678
# - VPS en producción: http://tu-dominio.com:5678 (o https si usas Caddy)
VITE_N8N_BASE_URL=http://localhost:5678

# ── Ollama — Motor de IA local (gratuito, sin tokens) ────────────────────────
# En producción (docker-compose) N8N accede a Ollama por el nombre del servicio.
# Esas variables se configuran directamente en el docker-compose.yml.
#
# Para desarrollo local SIN Docker, apunta a tu Ollama local:
OLLAMA_BASE_URL=http://localhost:11434

# Modelo de IA a usar. Selecciona según la RAM disponible en tu VPS:
#   qwen2.5:3b  → 3 GB RAM  (rápido, preciso para JSON estructurado)
#   qwen2.5:7b  → 5 GB RAM  (recomendado, mayor calidad)
#   mistral:7b  → 5 GB RAM  (alternativa, buena calidad en español)
#   llama3.1:8b → 6 GB RAM  (el mejor, más lento)
OLLAMA_MODEL=qwen2.5:7b
